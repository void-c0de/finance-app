# Public mobile configuration only. Never put provider secrets in this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
EXPO_PUBLIC_TINK_CLIENT_ID=YOUR_PUBLIC_TINK_CLIENT_ID

# Keep "sandbox" until Tink has activated a production Account Aggregation app.
# Production credentials must match the server-side TINK_CLIENT_ID secret.
EXPO_PUBLIC_TINK_ENVIRONMENT=sandbox
